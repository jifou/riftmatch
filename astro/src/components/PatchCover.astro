---
// Visuel de patch : numero de version en grand sur fond hextech.
// A placer dans un parent en position: relative ; le composant remplit le parent.
export interface Props {
  version: string
  type?: string
  word?: string
  size?: 'sm' | 'md' | 'lg'
}
const { version = '', type = 'live', word = 'PATCH', size = 'md' } = Astro.props
const live = type !== 'pbe'
const color = live ? '#c89b3c' : '#a855f7'
const parts = String(version).split('.')
---
<span class={`pc pc--${size}${live ? '' : ' pc--pbe'}`} style={`--c:${color}`} aria-hidden="true">
  <span class="pc-beam"></span>
  <span class="pc-hex"></span>
  <span class="pc-ghost">{version}</span>
  <span class="pc-center">
    <span class="pc-word">{word}</span>
    <span class="pc-ver">
      <b>{parts[0]}</b>{parts[1] !== undefined && <i>.</i>}{parts[1] !== undefined && <b>{parts[1]}</b>}
    </span>
    <span class="pc-bar"></span>
  </span>
</span>

<style is:global>
  .pc {
    position: absolute; inset: 0; display: block; overflow: hidden;
    background:
      radial-gradient(ellipse 65% 70% at 50% 50%, color-mix(in srgb, var(--c) 30%, transparent), transparent 72%),
      linear-gradient(150deg, #10141d 0%, #090b10 100%);
  }
  .pc-beam {
    position: absolute; inset: -30%; opacity: .5; filter: blur(26px);
    background: conic-gradient(from 200deg at 50% 50%, transparent 0 50%, color-mix(in srgb, var(--c) 55%, transparent) 68%, transparent 84%);
  }
  .pc-hex {
    position: absolute; inset: 0; opacity: .12;
    background-image:
      linear-gradient(30deg, #fff 12%, transparent 12.5%, transparent 87%, #fff 87.5%, #fff),
      linear-gradient(150deg, #fff 12%, transparent 12.5%, transparent 87%, #fff 87.5%, #fff);
    background-size: 44px 76px;
    mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, #000, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, #000, transparent 85%);
  }
  .pc-ghost {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); white-space: nowrap;
    font: 400 clamp(5rem, 22vw, 15rem)/1 'Russo One', sans-serif; color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--c) 40%, transparent); opacity: .5;
  }
  .pc-center { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: .35rem; z-index: 1; text-align: center; }
  .pc-word {
    font: 700 .8rem 'Rajdhani', sans-serif; letter-spacing: .5em; padding-left: .5em; color: color-mix(in srgb, var(--c) 70%, #fff);
    text-transform: uppercase; text-shadow: 0 2px 10px #000;
  }
  .pc-ver {
    display: inline-flex; align-items: baseline; font: 400 clamp(3.6rem, 14vw, 7.5rem)/.95 'Russo One', sans-serif;
    background: linear-gradient(180deg, #fff 25%, color-mix(in srgb, var(--c) 55%, #fff) 70%, var(--c));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 4px 18px rgba(0,0,0,.7)) drop-shadow(0 0 26px color-mix(in srgb, var(--c) 45%, transparent));
  }
  .pc-ver i { font-style: normal; padding: 0 .04em; opacity: .85; }
  .pc-bar { width: 84px; height: 3px; margin-top: .55rem; background: var(--c); box-shadow: 0 0 14px var(--c); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); }

  .pc--sm .pc-ghost { display: none; }
  .pc--sm .pc-center { inset: 0 0 auto 0; height: 58%; gap: .1rem; }
  .pc--sm .pc-word { font-size: .58rem; letter-spacing: .4em; padding-left: .4em; }
  .pc--sm .pc-ver { font-size: 2.6rem; }
  .pc--sm .pc-bar { width: 44px; height: 2px; margin-top: .2rem; }
  .pc--lg .pc-ghost { font-size: clamp(8rem, 30vw, 24rem); }
  a:hover .pc-ver { filter: drop-shadow(0 4px 18px rgba(0,0,0,.7)) drop-shadow(0 0 34px color-mix(in srgb, var(--c) 70%, transparent)); }
</style>
