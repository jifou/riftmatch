---
import Layout from '../../layouts/Layout.astro'

const PAYLOAD_URL = import.meta.env.PAYLOAD_API_URL || 'http://payload:3000'

// Locale depuis cookie (même pattern que GuidesPage)
const locale = Astro.cookies.get('locale')?.value || 'fr'
const dateLocale = locale === 'en' ? 'en-GB' : locale === 'es' ? 'es-ES' : 'fr-FR'

let news: any[] = []
try {
  let res = await fetch(`${PAYLOAD_URL}/api/news?where[status][equals]=published&where[or][0][locale][equals]=${locale}&where[or][1][locale][equals]=all&limit=100&sort=-publishedAt`)
  let data = await res.json()
  news = data.docs ?? []
  if (news.length === 0) {
    res = await fetch(`${PAYLOAD_URL}/api/news?where[status][equals]=published&limit=100&sort=-publishedAt`)
    data = await res.json()
    news = data.docs ?? []
  }
} catch { /* silent fail */ }

const CATEGORY_LABELS: Record<string, Record<string, string>> = {
  fr: { news: 'Actualité', champion: 'Champion', meta: 'Méta', esports: 'Esports', announcement: 'Annonce Riot', update: 'Mise à jour' },
  en: { news: 'News', champion: 'Champion', meta: 'Meta', esports: 'Esports', announcement: 'Riot Announcement', update: 'Update' },
  es: { news: 'Noticia', champion: 'Campeón', meta: 'Meta', esports: 'Esports', announcement: 'Anuncio Riot', update: 'Actualización' },
}
const catLabels = CATEGORY_LABELS[locale] ?? CATEGORY_LABELS.fr

const CATEGORY_COLORS: Record<string, string> = {
  news: 'var(--blue)', champion: 'var(--gold)', meta: 'var(--neon)',
  esports: '#22c55e', announcement: 'var(--red)', update: '#f97316',
}

const TYPE_META: Record<string, { label: string; color: string }> = {
  lck:             { label: 'LCK',           color: '#3b82f6' },
  lec:             { label: 'LEC',           color: '#a855f7' },
  lpl:             { label: 'LPL',           color: '#ef4444' },
  international:   { label: 'International', color: '#14b8a6' },
  'autres-regions':{ label: 'Autres régions',color: '#f97316' },
  riot:            { label: 'RIOT',          color: '#c89b3c' },
}

const SUBTYPE_LABELS: Record<string, Record<string, string>> = {
  fr: { resultats: 'Résultats', mercato: 'Mercato', other: 'Autre' },
  en: { resultats: 'Results',   mercato: 'Transfers', other: 'Other' },
  es: { resultats: 'Resultados',mercato: 'Mercado',   other: 'Otro'  },
}
const subLabels = SUBTYPE_LABELS[locale] ?? SUBTYPE_LABELS.fr

function formatDate(d: string) {
  if (!d) return ''
  return new Date(d).toLocaleDateString(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })
}

const featured = news[0] ?? null
const rest = news.slice(1)

const TITLES: Record<string, { title: string; desc: string; eyebrow: string; heading: string; sub: string; readMore: string; all: string; empty: string; filterLigue: string; filterType: string; filterAll: string; noResult: string }> = {
  fr: { title: 'News League of Legends | RiftMatch', desc: "Toute l'actualité League of Legends : patches, champions, méta, esports et annonces Riot Games.", eyebrow: 'Actualités', heading: 'News LoL', sub: 'Patches, champions, méta, esports — tout ce qui se passe dans le Rift', readMore: "Lire l'article →", all: 'Dernières actualités', empty: 'Aucune actualité disponible.', filterLigue: 'Ligue', filterType: 'Type', filterAll: 'Tous', noResult: 'Aucun article ne correspond à ces filtres.' },
  en: { title: 'League of Legends News | RiftMatch', desc: 'All League of Legends news: patches, champions, meta, esports and Riot announcements.', eyebrow: 'News', heading: 'LoL News', sub: 'Patches, champions, meta, esports — everything happening in the Rift', readMore: 'Read article →', all: 'Latest news', empty: 'No news available yet.', filterLigue: 'League', filterType: 'Type', filterAll: 'All', noResult: 'No articles match these filters.' },
  es: { title: 'Noticias de League of Legends | RiftMatch', desc: 'Toda la actualidad de League of Legends: parches, campeones, meta, esports y anuncios de Riot.', eyebrow: 'Noticias', heading: 'Noticias LoL', sub: 'Parches, campeones, meta, esports — todo lo que pasa en el Rift', readMore: 'Leer artículo →', all: 'Últimas noticias', empty: 'No hay noticias disponibles.', filterLigue: 'Liga', filterType: 'Tipo', filterAll: 'Todos', noResult: 'Ningún artículo coincide con estos filtros.' },
}
const t = TITLES[locale] ?? TITLES.fr
---

<Layout title={t.title} description={t.desc}>
  <main class="news-page">

    <!-- ── Hero header ─────────────────────────────────── -->
    <header class="news-hero">
      <p class="news-eyebrow">{t.eyebrow}</p>
      <h1 class="news-title">{t.heading.split(' ')[0]} <span class="gold">{t.heading.split(' ').slice(1).join(' ')}</span></h1>
      <p class="news-sub">{t.sub}</p>
    </header>

    {news.length === 0 ? (
      <div class="news-empty"><p>{t.empty}</p></div>
    ) : (
      <>
        <!-- ── Filtres ─────────────────────────────────── -->
        <div class="filter-bar" id="filter-bar">
          <div class="filter-row">
            <span class="filter-label">{t.filterLigue}</span>
            <div class="filter-pills">
              <button class="pill active" data-type="">
                {t.filterAll}
              </button>
              {Object.entries(TYPE_META).map(([val, meta]) => (
                <button class="pill" data-type={val} style={`--pill-color:${meta.color}`}>
                  {meta.label}
                </button>
              ))}
            </div>
          </div>
          <div class="filter-row">
            <span class="filter-label">{t.filterType}</span>
            <div class="filter-pills">
              <button class="pill sub active" data-sub="">
                {t.filterAll}
              </button>
              {Object.entries(subLabels).map(([val, label]) => (
                <button class="pill sub" data-sub={val}>
                  {label}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- ── Featured card ──────────────────────────────── -->
        {featured && (
          <a
            href={`/news/${featured.slug}`}
            class="featured-card"
            id="featured-card"
            data-newstype={featured.newsType ?? ''}
            data-newssubtype={featured.newsSubtype ?? ''}
          >
            {featured.coverImage
              ? <img src={featured.coverImage} alt={featured.title} loading="eager" class="featured-img" />
              : <div class="featured-img-placeholder"></div>
            }
            <div class="featured-gradient"></div>
            <div class="featured-body">
              <div class="featured-meta">
                {featured.newsType && (
                  <span class="type-badge" style={`--pill-color:${TYPE_META[featured.newsType]?.color ?? 'var(--gold)'}`}>
                    {TYPE_META[featured.newsType]?.label ?? featured.newsType}
                  </span>
                )}
                {featured.newsSubtype && (
                  <span class="subtype-badge">{subLabels[featured.newsSubtype] ?? featured.newsSubtype}</span>
                )}
              </div>
              <h2 class="featured-title">{featured.title}</h2>
              {featured.excerpt && <p class="featured-excerpt">{featured.excerpt}</p>}
              <div class="featured-footer">
                <span class="news-date">{formatDate(featured.publishedAt)}</span>
                <span class="read-more">{t.readMore}</span>
              </div>
            </div>
          </a>
        )}

        <!-- ── News grid ─────────────────────────────────── -->
        {rest.length > 0 && (
          <section class="news-grid-section" id="grid-section">
            <h2 class="section-title">{t.all}</h2>
            <ul class="news-grid" id="news-grid">
              {rest.map((item: any) => (
                <li class="news-card-item" data-newstype={item.newsType ?? ''} data-newssubtype={item.newsSubtype ?? ''}>
                  <a href={`/news/${item.slug}`} class="news-card">
                    {item.coverImage
                      ? <img src={item.coverImage} alt={item.title} loading="lazy" class="card-img" />
                      : <div class="card-img-placeholder"></div>
                    }
                    <div class="card-gradient"></div>
                    <div class="card-body">
                      <div class="card-tags">
                        {item.newsType && (
                          <span class="type-badge small" style={`--pill-color:${TYPE_META[item.newsType]?.color ?? 'var(--gold)'}`}>
                            {TYPE_META[item.newsType]?.label ?? item.newsType}
                          </span>
                        )}
                        {item.newsSubtype && (
                          <span class="subtype-badge small">{subLabels[item.newsSubtype] ?? item.newsSubtype}</span>
                        )}
                      </div>
                      <h3 class="card-title">{item.title}</h3>
                      <div class="card-footer">
                        <span class="news-date">{formatDate(item.publishedAt)}</span>
                        <span class="card-cta">Lire →</span>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <p class="no-result" id="no-result" style="display:none">{t.noResult}</p>
          </section>
        )}
      </>
    )}
  </main>
</Layout>

<script>
  const typeButtons = document.querySelectorAll<HTMLButtonElement>('.pill[data-type]')
  const subButtons  = document.querySelectorAll<HTMLButtonElement>('.pill[data-sub]')
  const featuredCard = document.getElementById('featured-card')
  const gridItems   = document.querySelectorAll<HTMLElement>('.news-card-item')
  const noResult    = document.getElementById('no-result')

  let activeType = ''
  let activeSub  = ''

  function matches(el: HTMLElement) {
    const t = el.dataset.newstype ?? ''
    const s = el.dataset.newssubtype ?? ''
    const typeOk = activeType === '' || t === activeType
    const subOk  = activeSub  === '' || s === activeSub
    return typeOk && subOk
  }

  function applyFilters() {
    // Featured card
    if (featuredCard) {
      featuredCard.style.display = matches(featuredCard) ? '' : 'none'
    }

    // Grid items
    let visible = 0
    gridItems.forEach(item => {
      const show = matches(item)
      item.style.display = show ? '' : 'none'
      if (show) visible++
    })

    // No-result message
    const featuredVisible = featuredCard && featuredCard.style.display !== 'none'
    if (noResult) noResult.style.display = (!featuredVisible && visible === 0) ? '' : 'none'
  }

  typeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      typeButtons.forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      activeType = btn.dataset.type ?? ''
      applyFilters()
    })
  })

  subButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      subButtons.forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      activeSub = btn.dataset.sub ?? ''
      applyFilters()
    })
  })
</script>

<style>
  .news-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.25rem 6rem;
  }

  /* ── Hero ──────────────────────────────────────────── */
  .news-hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .news-eyebrow {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }
  .news-title {
    font-family: 'Russo One', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--text-light);
    margin-bottom: 0.75rem;
  }
  .gold { color: var(--gold); }
  .news-sub {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Empty ─────────────────────────────────────────── */
  .news-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }

  /* ── Filter bar ────────────────────────────────────── */
  .filter-bar {
    background: var(--dark3);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .filter-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .filter-label {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
    min-width: 3.5rem;
    flex-shrink: 0;
  }
  .filter-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .pill {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .pill:hover {
    border-color: var(--pill-color, var(--gold));
    color: var(--pill-color, var(--gold));
    background: color-mix(in srgb, var(--pill-color, var(--gold)) 10%, transparent);
  }
  .pill.active {
    border-color: var(--pill-color, var(--gold));
    color: var(--pill-color, var(--gold));
    background: color-mix(in srgb, var(--pill-color, var(--gold)) 15%, transparent);
  }
  .pill.sub.active {
    border-color: var(--text-muted);
    color: var(--text-light);
    background: color-mix(in srgb, var(--text-muted) 15%, transparent);
  }
  .pill.sub:hover {
    border-color: var(--text-muted);
    color: var(--text-light);
    background: color-mix(in srgb, var(--text-muted) 10%, transparent);
  }

  /* ── Type / subtype badges ─────────────────────────── */
  .type-badge {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pill-color, var(--gold));
    background: color-mix(in srgb, var(--pill-color, var(--gold)) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--pill-color, var(--gold)) 40%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .subtype-badge {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    border: 1px solid var(--glass-border);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .type-badge.small, .subtype-badge.small {
    font-size: 0.62rem;
    padding: 0.1rem 0.45rem;
  }

  /* ── Featured card — full bleed ────────────────────── */
  .featured-card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 21/9;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s;
    margin-bottom: 3rem;
    cursor: pointer;
    border: 1px solid var(--glass-border);
  }
  .featured-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--glow-gold);
  }
  .featured-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.5s var(--ease-out);
  }
  .featured-card:hover .featured-img { transform: scale(1.04); }
  .featured-img-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--dark4) 0%, var(--dark2) 100%);
  }
  .featured-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10,10,15,0.97) 0%,
      rgba(10,10,15,0.7) 40%,
      rgba(10,10,15,0.1) 75%,
      transparent 100%
    );
  }
  .featured-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .featured-title {
    font-family: 'Russo One', sans-serif;
    font-size: clamp(1.3rem, 3vw, 2rem);
    color: #fff;
    line-height: 1.2;
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }
  .featured-excerpt {
    color: rgba(255,255,255,0.75);
    font-size: 0.9rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 680px;
  }
  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.25rem;
  }

  /* ── Category badges ───────────────────────────────── */
  .cat-badge {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cat-color, var(--gold));
    background: color-mix(in srgb, var(--cat-color, var(--gold)) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color, var(--gold)) 40%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  /* ── News date / read more ─────────────────────────── */
  .news-date {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
  }
  .read-more {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  /* ── Grid section ──────────────────────────────────── */
  .section-title {
    font-family: 'Russo One', sans-serif;
    font-size: 1.25rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--glass-border);
  }
  .news-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .no-result {
    text-align: center;
    color: var(--text-muted);
    padding: 3rem 0;
    font-size: 0.95rem;
  }

  /* ── News card — full bleed ─────────────────────────── */
  .news-card {
    position: relative;
    display: block;
    aspect-ratio: 16/9;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s;
    cursor: pointer;
    border: 1px solid var(--glass-border);
    height: 100%;
  }
  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(200,155,60,0.18);
  }
  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.4s var(--ease-out);
  }
  .news-card:hover .card-img { transform: scale(1.06); }
  .card-img-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--dark4) 0%, var(--dark2) 100%);
  }
  .card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10,10,15,0.97) 0%,
      rgba(10,10,15,0.65) 45%,
      rgba(10,10,15,0.05) 80%,
      transparent 100%
    );
  }
  .card-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .card-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .card-title {
    font-family: 'Russo One', sans-serif;
    font-size: 0.88rem;
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.1rem;
  }
  .card-cta {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    color: var(--gold);
  }

  /* ── Responsive ────────────────────────────────────── */
  @media (max-width: 900px) {
    .news-grid { grid-template-columns: repeat(2, 1fr); }
    .featured-card { aspect-ratio: 16/9; }
  }
  @media (max-width: 640px) {
    .featured-card { aspect-ratio: 4/3; }
    .featured-body { padding: 1.25rem 1rem; }
    .featured-title { font-size: 1.1rem; }
    .news-grid { grid-template-columns: 1fr 1fr; }
    .filter-label { min-width: 2.5rem; }
  }
  @media (max-width: 420px) {
    .news-grid { grid-template-columns: 1fr; }
  }
</style>
