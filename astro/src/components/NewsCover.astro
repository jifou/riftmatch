---
// Couverture d'une news : logo de la ligue sur fond hextech teinte de sa couleur.
// A placer dans un parent en position: relative ; le composant remplit le parent.
import { coverFor } from '../lib/news-cover'

export interface Props {
  item: any
  locale?: string
  cls?: string
  eager?: boolean
  alt?: string
  watermark?: boolean
  size?: 'sm' | 'md' | 'lg'
}
const { item, locale = 'fr', eager = false, alt = '', watermark = true, size = 'md' } = Astro.props
const c = coverFor(item, locale)
---
<span class={`nc nc--${size}${c.isRift ? ' nc--rift' : ''}`} style={`--c:${c.color}`} role="img" aria-label={alt || c.label}>
  <span class="nc-glow" aria-hidden="true"></span>
  <span class="nc-hex" aria-hidden="true"></span>
  <span class="nc-ring" aria-hidden="true"></span>
  <img class="nc-logo" src={c.logo} alt="" loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} />
  {watermark && <span class="nc-tag" aria-hidden="true">{c.tag}</span>}
</span>

<style is:global>
  .nc {
    position: absolute; inset: 0; display: block; overflow: hidden;
    background:
      radial-gradient(ellipse 60% 60% at 50% 34%, color-mix(in srgb, var(--c) 38%, transparent), transparent 70%),
      linear-gradient(160deg, #0f131c 0%, #090b10 100%);
  }
  .nc-glow {
    position: absolute; inset: -20%; opacity: .55;
    background: conic-gradient(from 210deg at 50% 50%, transparent 0 55%, color-mix(in srgb, var(--c) 50%, transparent) 70%, transparent 85%);
    filter: blur(22px);
  }
  .nc-hex {
    position: absolute; inset: 0; opacity: .13;
    background-image:
      linear-gradient(30deg, #fff 12%, transparent 12.5%, transparent 87%, #fff 87.5%, #fff),
      linear-gradient(150deg, #fff 12%, transparent 12.5%, transparent 87%, #fff 87.5%, #fff);
    background-size: 44px 76px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000 0%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000 0%, transparent 85%);
  }
  .nc-ring {
    position: absolute; left: 50%; top: 30%; width: min(40%, 40vh); aspect-ratio: 1; transform: translate(-50%, -50%);
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent); border-radius: 50%; opacity: .55;
    box-shadow: 0 0 40px color-mix(in srgb, var(--c) 30%, transparent) inset;
  }
  .nc-logo {
    position: absolute; left: 50%; top: 30%; transform: translate(-50%, -50%);
    width: 34%; height: 34%; object-fit: contain; z-index: 1;
    filter: drop-shadow(0 4px 18px rgba(0,0,0,.65)) drop-shadow(0 0 22px color-mix(in srgb, var(--c) 45%, transparent));
    transition: transform .5s var(--ease-out);
  }
  .nc--rift .nc-logo { width: 22%; height: 24%; border-radius: 22%; }
  a:hover .nc-logo { transform: translate(-50%, -50%) scale(1.07); }
  .nc-tag {
    position: absolute; top: .65rem; left: .8rem; z-index: 2; max-width: 80%;
    font: 700 .68rem 'Rajdhani', sans-serif; letter-spacing: .18em; text-transform: uppercase; color: #fff;
    padding: .22rem .6rem; background: color-mix(in srgb, var(--c) 82%, #000);
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .nc--lg .nc-tag { top: 5.5rem; left: 1.5rem; font-size: .9rem; padding: .35rem .9rem; }
  .nc--lg .nc-logo { top: 27%; width: 24%; height: 28%; }
  .nc--lg .nc-ring { top: 27%; width: min(34%, 34vh); }
  .nc--sm .nc-logo { width: 30%; height: 36%; top: 32%; }
  .nc--sm .nc-ring { top: 32%; width: min(36%, 36vh); }
  @media (max-width: 700px) {
    .nc--lg .nc-logo { top: 24%; width: 40%; height: 26%; }
    .nc--lg .nc-ring { top: 24%; width: min(52%, 30vh); }
    .nc--lg .nc-tag { top: 4.6rem; left: 1rem; font-size: .75rem; }
  }
</style>
