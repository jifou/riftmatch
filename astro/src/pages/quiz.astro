---
import Layout from '../layouts/Layout.astro'
import { QUESTIONS, TEXT, KEYS } from '../data/quiz-data.js'
import { UI } from '../i18n'
import { CHAMPIONS } from '../data/champions'
import AffiliateBlock from '../components/AffiliateBlock.astro'

const locale = Astro.cookies.get('locale')?.value || 'fr'
const L = (TEXT as any)[locale] ? locale : 'fr'
const T = (TEXT as any)[L]
const t = (UI as any)[L] || (UI as any).fr
const champBase = L === 'fr' ? '/champion' : `/${L}/champion`

// Donnees minimales envoyees au navigateur (pas les 173 objets complets)
const champs = CHAMPIONS.map((c: any) => ({
  name: c.name, apiId: c.apiId, lanes: c.lanes, archetypes: c.archetypes,
  styles: c.styles, faction: c.faction, difficulty: c.difficulty,
}))
const questions = QUESTIONS.map((q: any, i: number) => ({
  id: q.id, bg: q.bg, n: q.answers.length, q: T.questions[i].q, a: T.questions[i].a,
}))
const faq = {
  fr: [['Comment fonctionne le quiz RiftMatch ?', "Réponds à 8 questions posées comme au champion select. Chaque réponse pèse sur ton rôle, ton style de combat, ta difficulté et ta région préférée, puis on te propose les 3 champions les plus compatibles."], ['Le quiz est-il gratuit ?', 'Oui, il est gratuit et sans inscription.'], ['Combien de champions sont couverts ?', `Les ${CHAMPIONS.length} champions du jeu.`]],
  en: [['How does the RiftMatch quiz work?', 'Answer 8 questions framed like champion select. Each answer weighs your role, fighting style, difficulty and favorite region, then we suggest the 3 best matching champions.'], ['Is the quiz free?', 'Yes, it is free and needs no sign-up.'], ['How many champions are covered?', `All ${CHAMPIONS.length} champions in the game.`]],
  es: [['¿Cómo funciona el quiz de RiftMatch?', 'Responde 8 preguntas planteadas como en la selección de campeón. Cada respuesta pesa en tu línea, estilo de combate, dificultad y región favorita, y te proponemos los 3 campeones más compatibles.'], ['¿El quiz es gratis?', 'Sí, es gratis y no requiere registro.'], ['¿Cuántos campeones cubre?', `Los ${CHAMPIONS.length} campeones del juego.`]],
  de: [['Wie funktioniert das RiftMatch-Quiz?', 'Beantworte 8 Fragen im Stil der Champion-Auswahl. Jede Antwort beeinflusst Lane, Kampfstil, Schwierigkeit und Lieblingsregion, dann schlagen wir dir die 3 passendsten Champions vor.'], ['Ist das Quiz kostenlos?', 'Ja, es ist kostenlos und ohne Anmeldung.'], ['Wie viele Champions sind abgedeckt?', `Alle ${CHAMPIONS.length} Champions des Spiels.`]],
  it: [['Come funziona il quiz di RiftMatch?', 'Rispondi a 8 domande impostate come nella selezione dei campioni. Ogni risposta pesa su lane, stile di combattimento, difficoltà e regione preferita, poi ti proponiamo i 3 campioni più compatibili.'], ['Il quiz è gratuito?', 'Sì, è gratuito e senza registrazione.'], ['Quanti campioni sono coperti?', `Tutti i ${CHAMPIONS.length} campioni del gioco.`]],
}[L as 'fr']
---

<Layout title={t.quizPage.title} description={t.quizPage.description} lang={locale}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(([q, a]: string[]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })),
  })} />

  <main class="qz" id="qz"
    data-champs={JSON.stringify(champs)}
    data-questions={JSON.stringify(questions)}
    data-text={JSON.stringify({ ui: T.ui, lanes: T.lanes, arch: T.arch, diff: T.diff, regions: T.regions, keys: KEYS, champBase })}
  >
    <div class="qz-bg" id="qz-bg" aria-hidden="true"></div>
    <div class="qz-shade" aria-hidden="true"></div>

    <!-- Questions -->
    <section id="qz-screen" class="qz-screen">
      <div class="qz-top">
        <button id="qz-back" class="qz-back" aria-label={T.ui.back}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 13L5 8l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="qz-head">
          <span class="qz-kicker">{T.ui.header}</span>
          <div class="qz-steps" id="qz-steps" aria-hidden="true"></div>
        </div>
        <span class="qz-count" id="qz-count">1/8</span>
      </div>

      <div class="qz-card" id="qz-card">
        <h1 class="qz-q" id="qz-q"></h1>
        <div class="qz-answers" id="qz-answers" role="group"></div>
        <p class="qz-hint">{T.ui.hint}</p>
      </div>
    </section>

    <!-- Resultat -->
    <section id="rs-screen" class="rs-screen" hidden>
      <div class="rs-splash" id="rs-splash" aria-hidden="true"></div>
      <div class="rs-inner">
        <p class="rs-tag">{T.ui.resultTag}</p>
        <p class="rs-youare">{T.ui.youAre}</p>
        <h1 class="rs-name" id="rs-name"></h1>
        <p class="rs-sub" id="rs-sub"></p>

        <div class="rs-pct">
          <div class="rs-pct-track"><div class="rs-pct-fill" id="rs-pct-fill"></div></div>
          <span class="rs-pct-label" id="rs-pct-label"></span>
        </div>
        <ul class="rs-chips" id="rs-chips"></ul>

        <div class="rs-actions">
          <a class="rs-cta" id="rs-cta" href="#">{T.ui.cta}</a>
          <button class="rs-btn" id="rs-share" type="button">{T.ui.share}</button>
          <button class="rs-btn" id="rs-dl" type="button">{T.ui.download}</button>
        </div>
        <p class="rs-toast" id="rs-toast" role="status" aria-live="polite"></p>

        <h2 class="rs-alt-title">{T.ui.alternatives}</h2>
        <div class="rs-alts" id="rs-alts"></div>

        <AffiliateBlock variant="card" locale={locale} />
        <button class="rs-restart" id="rs-restart" type="button">{T.ui.restart}</button>
        <AffiliateBlock variant="banner" locale={locale} />
      </div>
    </section>
  </main>
</Layout>
<script>
  import { calculateResults } from '../lib/quiz.js'

  const root = document.getElementById('qz') as HTMLElement
  const champs = JSON.parse(root.dataset.champs || '[]')
  const questions = JSON.parse(root.dataset.questions || '[]')
  const X = JSON.parse(root.dataset.text || '{}')
  const U = X.ui
  const SPLASH = 'https://ddragon.leagueoflegends.com/cdn/img/champion/splash'
  const LOADING = 'https://ddragon.leagueoflegends.com/cdn/img/champion/loading'
  const total = questions.length

  const $ = (id: string) => document.getElementById(id) as HTMLElement
  const answers: number[] = []
  let step = 0
  let locked = false

  // Prechargement des splash arts des questions (en douceur)
  questions.forEach((q: any) => { const i = new Image(); i.src = `${SPLASH}/${q.bg}_0.jpg` })

  function setBg(name: string) {
    const bg = $('qz-bg')
    bg.style.backgroundImage = `url(${SPLASH}/${name}_0.jpg)`
    bg.classList.remove('qz-bg--in'); void bg.offsetWidth; bg.classList.add('qz-bg--in')
  }

  function renderSteps() {
    $('qz-steps').innerHTML = questions.map((_: any, i: number) =>
      `<i class="${i < step ? 'done' : i === step ? 'now' : ''}"></i>`).join('')
    $('qz-count').textContent = `${step + 1}/${total}`
  }

  function render() {
    locked = false
    const q = questions[step]
    setBg(q.bg)
    renderSteps()
    $('qz-q').textContent = q.q
    const box = $('qz-answers')
    box.innerHTML = ''
    q.a.forEach((txt: string, idx: number) => {
      const b = document.createElement('button')
      b.type = 'button'
      b.className = 'qz-ans'
      b.style.setProperty('--d', `${idx * 55}ms`)
      b.innerHTML = `<span class="qz-key">${X.keys[idx] || idx + 1}</span><span class="qz-txt"></span>`
      ;(b.querySelector('.qz-txt') as HTMLElement).textContent = txt
      b.onclick = () => pick(idx, b)
      box.appendChild(b)
    })
    const card = $('qz-card')
    card.classList.remove('qz-card--in'); void card.offsetWidth; card.classList.add('qz-card--in')
  }

  function pick(idx: number, btn: HTMLElement) {
    if (locked) return
    locked = true
    btn.classList.add('qz-ans--locked')
    document.querySelectorAll('.qz-ans').forEach(b => { if (b !== btn) b.classList.add('qz-ans--dim') })
    setTimeout(() => {
      answers.push(idx)
      step++
      if (step < total) render()
      else showResult()
    }, 420)
  }

  function back() {
    if (locked) return
    if (step === 0) { window.location.href = '/'; return }
    step--; answers.pop(); render()
  }

  document.addEventListener('keydown', (e) => {
    if ($('qz-screen').hidden) return
    const i = X.keys.findIndex((k: string) => k.toLowerCase() === e.key.toLowerCase())
    const btns = document.querySelectorAll<HTMLElement>('.qz-ans')
    if (i >= 0 && btns[i]) { e.preventDefault(); btns[i].click() }
    if (e.key === 'Backspace' || e.key === 'ArrowLeft') back()
  })
  $('qz-back').onclick = back

  // ── Resultat ───────────────────────────────────────────
  let resultTop: any = null

  function chips(c: any) {
    const out: string[] = []
    c.lanes.forEach((l: string) => out.push(`<li class="${c.matched.lanes.includes(l) ? 'on' : ''}">${X.lanes[l] || l}</li>`))
    c.archetypes.forEach((a: string) => out.push(`<li class="${c.matched.arch.includes(a) ? 'on' : ''}">${X.arch[a] || a}</li>`))
    out.push(`<li class="${c.matched.faction ? 'on' : ''}">${X.regions[c.faction] || c.faction}</li>`)
    out.push(`<li class="diff d${c.difficulty}">${X.diff[c.difficulty] || ''}</li>`)
    return out.join('')
  }

  function showResult() {
    const res = calculateResults(champs, answers)
    const top = res[0]
    resultTop = top
    $('qz-screen').hidden = true
    const rs = $('rs-screen')
    rs.hidden = false
    document.body.classList.add('rs-open')
    window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior })

    $('qz-bg').style.backgroundImage = ''
    $('rs-splash').style.backgroundImage = `url(${SPLASH}/${top.apiId}_0.jpg)`
    $('rs-name').textContent = top.name
    $('rs-sub').textContent = [
      top.lanes.map((l: string) => X.lanes[l] || l).join(' / '),
      top.archetypes.map((a: string) => X.arch[a] || a).join(' / '),
    ].join('  ·  ')
    $('rs-pct-label').textContent = `${top.matchPct}% ${U.match}`
    requestAnimationFrame(() => { $('rs-pct-fill').style.width = `${top.matchPct}%` })
    $('rs-chips').innerHTML = chips(top)
    ;($('rs-cta') as HTMLAnchorElement).href = `${X.champBase}/${top.apiId}`

    $('rs-alts').innerHTML = res.slice(1).map((c: any) => `
      <a class="rs-alt" href="${X.champBase}/${c.apiId}">
        <img src="${LOADING}/${c.apiId}_0.jpg" alt="${c.name}" loading="lazy" width="120" height="220"/>
        <div class="rs-alt-info">
          <strong>${c.name}</strong>
          <span class="rs-alt-pct">${c.matchPct}% ${U.match}</span>
          <ul class="rs-chips rs-chips--sm">${chips(c)}</ul>
          <em>${U.ctaShort} →</em>
        </div>
      </a>`).join('')
  }

  // ── Partage / carte image ──────────────────────────────
  function toast(msg: string) {
    const el = $('rs-toast'); el.textContent = msg
    setTimeout(() => { if (el.textContent === msg) el.textContent = '' }, 2500)
  }

  function loadImg(src: string): Promise<HTMLImageElement> {
    return new Promise((res, rej) => {
      const i = new Image(); i.crossOrigin = 'anonymous'
      i.onload = () => res(i); i.onerror = rej; i.src = src
    })
  }

  async function buildCard(): Promise<Blob> {
    const W = 1080, H = 1350
    const cv = document.createElement('canvas'); cv.width = W; cv.height = H
    const g = cv.getContext('2d')!
    g.fillStyle = '#090b10'; g.fillRect(0, 0, W, H)
    try {
      const img = await loadImg(`${SPLASH}/${resultTop.apiId}_0.jpg`)
      const r = Math.max(W / img.width, (H * 0.78) / img.height)
      const w = img.width * r, h = img.height * r
      g.drawImage(img, (W - w) / 2, 0, w, h)
    } catch {}
    const grad = g.createLinearGradient(0, H * 0.35, 0, H)
    grad.addColorStop(0, 'rgba(9,11,16,0)'); grad.addColorStop(0.62, 'rgba(9,11,16,0.92)'); grad.addColorStop(1, '#090b10')
    g.fillStyle = grad; g.fillRect(0, 0, W, H)
    g.strokeStyle = '#c89b3c'; g.lineWidth = 6; g.strokeRect(24, 24, W - 48, H - 48)
    g.textAlign = 'center'
    g.fillStyle = '#c89b3c'; g.font = '600 34px Rajdhani, sans-serif'
    g.fillText(U.cardKicker.toUpperCase(), W / 2, 960)
    g.fillStyle = '#f0e6b2'; g.font = '92px "Russo One", sans-serif'
    g.fillText(resultTop.name, W / 2, 1060)
    g.fillStyle = '#e1e6f0'; g.font = '600 40px Rajdhani, sans-serif'
    g.fillText(`${resultTop.matchPct}% ${U.match}`, W / 2, 1125)
    g.fillStyle = '#8892b0'; g.font = '30px Inter, sans-serif'
    g.fillText(resultTop.lanes.map((l: string) => X.lanes[l] || l).join(' / ') + '  ·  ' + resultTop.archetypes.map((a: string) => X.arch[a] || a).join(' / '), W / 2, 1180)
    g.fillStyle = '#c89b3c'; g.font = '700 46px Rajdhani, sans-serif'
    g.fillText('RIFTMATCH.IO', W / 2, 1270)
    return new Promise((res, rej) => cv.toBlob(b => b ? res(b) : rej(new Error('blob')), 'image/png'))
  }

  $('rs-dl').onclick = async () => {
    try {
      const blob = await buildCard()
      const a = document.createElement('a')
      a.href = URL.createObjectURL(blob); a.download = `riftmatch-${resultTop.apiId}.png`
      a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 4000)
    } catch { toast('Erreur') }
  }

  $('rs-share').onclick = async () => {
    const text = U.shareText(resultTop.name, resultTop.matchPct)
    const url = 'https://riftmatch.io/quiz'
    try {
      const blob = await buildCard()
      const file = new File([blob], `riftmatch-${resultTop.apiId}.png`, { type: 'image/png' })
      const nav: any = navigator
      if (nav.canShare && nav.canShare({ files: [file] })) { await nav.share({ files: [file], text, url }); return }
      if (nav.share) { await nav.share({ text, url }); return }
    } catch (e: any) { if (e && e.name === 'AbortError') return }
    try { await navigator.clipboard.writeText(`${text} ${url}`); toast(U.copied) } catch { toast(url) }
  }

  $('rs-restart').onclick = () => { window.location.href = '/quiz' }

  render()
</script>

<style is:global>
  .qz { position: relative; min-height: calc(100vh - 64px); isolation: isolate; overflow: hidden; }
  .qz-bg {
    position: fixed; inset: 0; z-index: -2; background-size: cover; background-position: center 20%;
    filter: saturate(1.15); transform: scale(1.06); opacity: 0;
  }
  .qz-bg--in { animation: qzBg 0.8s var(--ease-out) forwards; }
  @keyframes qzBg { from { opacity: 0; transform: scale(1.1); } to { opacity: 0.95; transform: scale(1.04); } }
  .qz-shade {
    position: fixed; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse 60% 55% at 50% 38%, rgba(9,11,16,0.05), rgba(9,11,16,0.7) 85%),
      linear-gradient(180deg, rgba(9,11,16,0.25), rgba(9,11,16,0.85));
  }

  .qz-screen { max-width: 760px; margin: 0 auto; padding: 1.75rem 1.25rem 4rem; }
  .qz-screen[hidden], .rs-screen[hidden] { display: none; }

  .qz-top { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .qz-back {
    width: 40px; height: 40px; flex-shrink: 0; display: grid; place-items: center; cursor: pointer;
    background: rgba(9,11,16,0.7); color: var(--gold); border: 1px solid rgba(200,155,60,0.35);
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    transition: background .2s, color .2s;
  }
  .qz-back:hover { background: rgba(200,155,60,0.18); color: var(--gold-light); }
  .qz-head { flex: 1; display: grid; gap: .5rem; }
  .qz-kicker { font-family: 'Rajdhani', sans-serif; font-weight: 700; letter-spacing: .28em; font-size: .72rem; color: var(--gold); text-transform: uppercase; }
  .qz-steps { display: flex; gap: 6px; }
  .qz-steps i {
    flex: 1; height: 6px; background: rgba(255,255,255,.1);
    clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%);
    transition: background .3s, box-shadow .3s;
  }
  .qz-steps i.done { background: var(--gold); }
  .qz-steps i.now { background: var(--gold-light); box-shadow: 0 0 10px rgba(240,230,178,.7); }
  .qz-count { font-family: 'Rajdhani', sans-serif; font-weight: 700; color: var(--text-muted); letter-spacing: .08em; }

  .qz-card {
    position: relative; padding: 2rem 1.6rem 1.4rem;
    background: linear-gradient(180deg, rgba(14,17,24,.8), rgba(9,11,16,.88));
    border: 1px solid rgba(200,155,60,.4);
    box-shadow: 0 0 0 1px rgba(0,0,0,.6) inset, 0 20px 60px rgba(0,0,0,.55), var(--glow-gold);
    clip-path: polygon(18px 0, calc(100% - 18px) 0, 100% 18px, 100% calc(100% - 18px), calc(100% - 18px) 100%, 18px 100%, 0 calc(100% - 18px), 0 18px);
  }
  .qz-card::before {
    content: ''; position: absolute; top: 0; left: 18px; right: 18px; height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .qz-card--in { animation: qzIn .45s var(--ease-out); }
  @keyframes qzIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .qz-q { font-size: clamp(1.25rem, 3.6vw, 1.75rem); line-height: 1.3; margin-bottom: 1.6rem; color: var(--gold-light); text-wrap: balance; }
  .qz-answers { display: grid; gap: .6rem; }
  .qz-ans {
    --d: 0ms; position: relative; display: flex; align-items: center; gap: .9rem; width: 100%;
    text-align: left; cursor: pointer; padding: .85rem 1rem;
    background: rgba(21,25,35,.85); color: var(--text-light); border: 1px solid rgba(200,155,60,.18);
    font: 500 .98rem/1.35 'Inter', sans-serif;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    animation: ansIn .4s var(--ease-out) var(--d) both;
    transition: background .18s, border-color .18s, transform .18s, opacity .25s, box-shadow .18s;
  }
  @keyframes ansIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }
  .qz-key {
    flex-shrink: 0; width: 30px; height: 30px; display: grid; place-items: center;
    font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: .9rem; color: var(--gold);
    border: 1px solid rgba(200,155,60,.5); background: rgba(200,155,60,.08);
    transition: background .18s, color .18s;
  }
  .qz-ans:hover, .qz-ans:focus-visible {
    outline: none; background: rgba(200,155,60,.12); border-color: var(--gold); transform: translateX(4px);
    box-shadow: inset 3px 0 0 var(--gold), var(--glow-gold);
  }
  .qz-ans:hover .qz-key, .qz-ans:focus-visible .qz-key { background: var(--gold); color: #090b10; }
  .qz-ans--locked { background: rgba(200,155,60,.28) !important; border-color: var(--gold-light) !important; box-shadow: 0 0 22px rgba(240,230,178,.45) !important; transform: translateX(6px) !important; }
  .qz-ans--locked .qz-key { background: var(--gold-light); color: #090b10; }
  .qz-ans--dim { opacity: .3; }
  .qz-hint { margin-top: 1.1rem; font-size: .75rem; color: var(--text-dim); text-align: center; }
  @media (hover: none) { .qz-hint { display: none; } }

  /* ── Resultat ── */
  .rs-screen { position: relative; }
  .rs-splash {
    position: absolute; inset: 0 0 auto 0; height: 78vh; min-height: 520px; z-index: -1;
    background-size: cover; background-position: center 18%;
    mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 100%);
    animation: rsSplash 1.2s var(--ease-out) both;
  }
  @keyframes rsSplash { from { opacity: 0; transform: scale(1.08); } to { opacity: .9; transform: none; } }
  .rs-inner { max-width: 820px; margin: 0 auto; padding: 4.5rem 1.25rem 4rem; }
  .rs-tag { font-family: 'Rajdhani', sans-serif; font-weight: 700; letter-spacing: .3em; font-size: .78rem; color: var(--gold); text-transform: uppercase; text-shadow: 0 2px 10px #000; }
  .rs-youare { margin-top: 5.5rem; font-family: 'Rajdhani', sans-serif; font-size: 1.15rem; letter-spacing: .2em; color: var(--text-light); text-transform: uppercase; text-shadow: 0 2px 12px #000; }
  .rs-name {
    font-size: clamp(3rem, 12vw, 6.2rem); line-height: 1; margin: .15em 0 .1em; color: var(--gold-light);
    text-shadow: 0 0 40px rgba(200,155,60,.55), 0 4px 18px #000; text-transform: uppercase;
    animation: rsName .8s var(--ease-out) .25s both;
  }
  @keyframes rsName { from { opacity: 0; letter-spacing: .25em; } to { opacity: 1; letter-spacing: .01em; } }
  .rs-sub { font-family: 'Rajdhani', sans-serif; font-weight: 600; letter-spacing: .12em; color: var(--text-muted); text-transform: uppercase; text-shadow: 0 2px 10px #000; }
  .rs-pct { display: flex; align-items: center; gap: .9rem; margin: 1.4rem 0 1rem; max-width: 440px; }
  .rs-pct-track { flex: 1; height: 8px; background: rgba(255,255,255,.12); clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%); }
  .rs-pct-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--gold), var(--gold-light)); box-shadow: 0 0 12px rgba(240,230,178,.6); transition: width 1.1s var(--ease-out) .5s; }
