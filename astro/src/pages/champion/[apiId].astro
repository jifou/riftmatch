---
import ChampionPage from '../../components/pages/ChampionPage.astro'
import { CHAMPIONS } from '../../data/champions'

const { apiId } = Astro.params
if (!CHAMPIONS.some(c => c.apiId === apiId)) return Astro.redirect('/', 302)
const pref = Astro.cookies.get('locale')?.value || 'fr'
if (['en', 'es', 'de', 'it'].includes(pref)) return Astro.redirect(`/${pref}/champion/${apiId}`, 302)
---
<ChampionPage />
