#!/bin/sh
# Refuse le push si une migration ajoutee ou modifiee ne passe pas scripts/check-migration.mjs.
# Activation (une fois par clone): git config core.hooksPath scripts/git-hooks
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; base=$(git merge-base "$local_sha" origin/main 2>/dev/null) && range="$base..$local_sha"
  else range="$remote_sha..$local_sha"; fi
  files=$(git diff --name-only --diff-filter=AM "$range" -- 'payload/src/migrations/[0-9]*.ts')
  [ -z "$files" ] && continue
  # shellcheck disable=SC2086
  node scripts/check-migration.mjs $files || status=1
done
[ "$status" -ne 0 ] && echo "Push refuse: migration invalide (voir ci-dessus)." >&2
exit $status
